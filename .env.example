# Copy this file to .env and edit the values there.

# GPU model settings (training, evaluation, and API inference require CUDA).
TSL_DEVICE=cuda
TSL_EXPERIMENT_DIR=experiments/resnet18-gpu-smoke-v1
TSL_EVALUATION_DIR=

# Training defaults used by scripts/4-Train-Model.ps1.
TSL_ARCHITECTURE=resnet18
TSL_EPOCHS=20
TSL_BATCH_SIZE=16
TSL_LEARNING_RATE=0.001
TSL_WEIGHT_DECAY=0.0001
TSL_SEED=42
TSL_NUM_WORKERS=0
TSL_OUTPUT_DIR=experiments/resnet18-from-env

# Local web services.
TSL_API_HOST=127.0.0.1
TSL_API_PORT=8000
TSL_FRONTEND_HOST=127.0.0.1
TSL_FRONTEND_PORT=5173
VITE_TSL_API_URL=http://127.0.0.1:8000
